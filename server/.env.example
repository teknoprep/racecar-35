# Copy to .env and edit. docker-compose reads it automatically.
#
# Host port the app listens on (both docker-compose.yml and .prod.yml).
# Defaults to 9000 if unset. An external reverse proxy terminates TLS and
# forwards RACECAR_DOMAIN -> http://<this-host>:<RACECAR_HOST_PORT>.
# Change this to move the service (e.g. if 9000 is taken), then
# `docker compose ... up -d` to recreate on the new port — no rebuild needed.
RACECAR_HOST_PORT=9000

# Public domain that resolves to the reverse proxy. Informational here; used
# only to remind you which host the dash + OAuth redirect should point at.
RACECAR_DOMAIN=racecar.api.blueuc.com

# Dash upload API key. If set, firmware must send X-API-Key: <this value>.
# Leave blank for bench/dev mode.
RACECAR_API_KEY=

# Google OAuth for the browser UI. Leave GOOGLE_CLIENT_ID/SECRET blank to keep
# the web UI in open dev mode. Once both are set, /, /sessions, /review,
# downloads, manual uploads, and deletes require Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Dev/LAN (HTTP):   http://<lan-ip>:8089/auth/google/callback
# Production (HTTPS): https://racecar.api.blueuc.com/auth/google/callback
GOOGLE_REDIRECT_URI=https://racecar.api.blueuc.com/auth/google/callback

# Required once OAuth is enabled. Use a long random string.
RACECAR_SESSION_SECRET=

# Optional comma-separated allowlist. Blank = any Google-verified account
# (unless RACECAR_ADMIN_EMAILS below is set, which also activates the allowlist).
# Normally you leave this blank and manage accounts from the /admin portal.
# Example: RACECAR_ALLOWED_EMAILS=cm.rawlings@gmail.com,driver2@gmail.com
RACECAR_ALLOWED_EMAILS=

# Bootstrap admin(s) for the /admin portal (comma-separated). These accounts
# can always sign in and always have admin rights, and are the ONLY accounts
# that can use /admin at first. From there, an admin adds other Gmail accounts
# and optionally grants them admin too (stored in /data/users.json, editable
# without a redeploy). Setting this also restricts sign-in to the allowlist.
RACECAR_ADMIN_EMAILS=cm.rawlings@gmail.com

# Firmware-upload key (gates POST /firmware/upload used by publish_firmware.sh).
# DELIBERATELY separate from RACECAR_API_KEY so locking down firmware uploads
# does NOT force every dash session upload to send that key. Falls back to
# RACECAR_API_KEY only if unset.
RACECAR_FIRMWARE_KEY=

# ---- AI corner analysis (review page) --------------------------------------
# The review page can send the telemetry inside a user-drawn track region to an
# LLM for coaching (entry/exit speed, brake zones, best line). Talks to Open
# WebUI's OpenAI-compatible API. Leave RACECAR_AI_API_KEY blank to hide the AI
# panel entirely.
RACECAR_AI_BASE_URL=https://ai.blueuc.com
RACECAR_AI_API_KEY=
# DEFAULT model id. Open WebUI hosts MANY models, so this names the one used
# when a request doesn't override it. Must match an id from GET {base}/api/models
# EXACTLY — on ai.blueuc.com the Anthropic ids carry an "anthropic.anthropic/"
# prefix, e.g. RACECAR_AI_MODEL=anthropic.anthropic/claude-sonnet-5
# (the short "anthropic/claude-sonnet-5" returns "Model not found").
RACECAR_AI_MODEL=
# Model ALLOWLIST (CSV). When set, these are the ONLY models the UI offers and
# the ONLY ones the server accepts — the live 100+ catalogue is hidden and any
# other id is forced to the default. If left blank it falls back to just
# [RACECAR_AI_MODEL]; set BOTH blank to expose the full live catalogue.
# Example: RACECAR_AI_MODELS=anthropic.anthropic/claude-sonnet-5,openai_responses.gpt-4o-mini
RACECAR_AI_MODELS=
RACECAR_AI_TIMEOUT_SECONDS=120
# Sampling temperature. LEAVE BLANK for newer models — Anthropic claude-sonnet-5
# and friends REJECT the temperature param ("temperature is deprecated for this
# model"), so we omit it entirely unless you set a value here (e.g. 0.3).
RACECAR_AI_TEMPERATURE=

# Keep 0 for plain HTTP LAN testing. Use 1 behind HTTPS (the prod compose
# defaults this to 1 automatically).
RACECAR_COOKIE_SECURE=0
RACECAR_SESSION_TTL_SECONDS=604800

# ---- Basemap for the session map (review page / playback) ------------------
# Optional; the server already defaults to keyless Esri imagery. CARTO's raster
# basemaps now REQUIRE an API key — without one, basemaps.cartocdn.com serves a
# 256x256 "API KEY REQUIRED" placeholder tile instead of map data, which is what
# broke the review-page map. Read at startup, so `docker compose up -d` is enough
# — no --build. Leave these commented out: a BLANK value means "use the default",
# and only the literal `none` removes the basemap.
#
# Dark canvas instead of imagery (keeps the old dark map look, native to z16):
#   RACECAR_MAP_TILES=https://server.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Dark_Gray_Base/MapServer/tile/{z}/{y}/{x}
#   RACECAR_MAP_ATTRIB=Tiles (c) Esri
#   RACECAR_MAP_MAXZOOM=16
# Set RACECAR_MAP_TILES=none for no basemap at all.
# Esri paths are /{z}/{y}/{x} (row/col), NOT /{z}/{x}/{y}.
# RACECAR_MAP_TILES=
# RACECAR_MAP_ATTRIB=
# RACECAR_MAP_MAXZOOM=19

# ---- Elevation for the first-person 3D view (/track3d) ---------------------
# Also keyless: AWS's open "terrarium" terrain tiles (Mapzen/Amazon terrain,
# SRTM and friends), PNG-encoded, CORS-open, no API key. MapLibre decodes them
# with encoding="terrarium". The literal `none` disables 3D terrain (flat
# ground; imagery and lines still work). Read at startup.
#   RACECAR_MAP_DEM=https://s3.amazonaws.com/elevation-tiles-prod/terrarium/{z}/{x}/{y}.png
#   RACECAR_MAP_DEM=none
# NOTE the DEM has native data only to ~z15 (upsampled above that).
# RACECAR_MAP_DEM=
