# Copy to config.env next to recorder.py and edit.

UART_DEV=/dev/serial0
UART_BAUD=115200

# Leave blank to auto-pick USB UVC cameras: first=front, second=rear PIP.
FRONT=
BACK=

FRONT_SIZE=1920x1080
BACK_SIZE=1920x1080
FPS=30

# Any USB stick/SSD is auto-detected and mounted. Do not pin a path.

X264_PRESET=veryfast
VIDEO_BITRATE=8M

PIP_W=480
PIP_H=270
PIP_MARGIN=16
